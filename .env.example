# CarteraArgentina — configuration template.
#
# Copy to .env ONLY for the initial hydration run (`cartera config hydrate`).
# The hydration wizard reads this file, stores every secret in the OS keyring,
# verifies the round-trip, and then offers to delete the plaintext file.
# Never commit a filled-in copy: .env is gitignored for that reason.
#
# Precedence: CLI flags > environment > this file > built-in defaults.
# Non-secret settings belong in the TOML config (`cartera config show`).

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Database file (append-only ledger). Default: XDG data dir.
CARTERA_DB_PATH=""
# Directory for snapshots and generated reports.
CARTERA_DATA_DIR=""
# Timezone used to date quotes from sources that only report a clock time.
CARTERA_TZ="America/Argentina/Buenos_Aires"

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
CARTERA_HTTP_TIMEOUT_S="20"
# A quote older than this is refused by the analysis pipeline.
CARTERA_MAX_QUOTE_AGE_S="43200"

# ---------------------------------------------------------------------------
# Commissions (percent, defaults are a public broker schedule — override yours)
# ---------------------------------------------------------------------------
CARTERA_COMMISSION_EQUITY_PCT="0.33"
CARTERA_COMMISSION_CEDEAR_PCT="0.33"
CARTERA_COMMISSION_BOND_PCT="0.26"
CARTERA_COMMISSION_CORP_BOND_PCT="0.26"

# ---------------------------------------------------------------------------
# Analysis backend (optional; all metrics are computed in code, never by a model)
# ---------------------------------------------------------------------------
CARTERA_LLM_PROVIDER=""
CARTERA_LLM_BASE_URL=""
CARTERA_LLM_MODEL=""
# Secret: hydrated into the OS keyring, never read from this file at runtime.
CARTERA_LLM_API_KEY=""

# ---------------------------------------------------------------------------
# Web UI (optional, loopback only by default)
# ---------------------------------------------------------------------------
CARTERA_WEB_HOST="127.0.0.1"
CARTERA_WEB_PORT="8787"
# Secret: hydrated into the OS keyring.
CARTERA_WEB_TOKEN=""

CARTERA_LOG_LEVEL="INFO"
